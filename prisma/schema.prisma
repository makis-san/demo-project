generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  name         String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  passwordHash String
  workouts     Workout[]
  movements    Movement[]
  bodyWeights  BodyWeight[]
  sessions     Session[]
  presets      WorkoutPreset[]
}

// A signed-in browser. The cookie holds a random token, and only its SHA-256 is
// stored, so a copy of this table cannot be used to sign in. Deleting the row
// signs that browser out.
//
// expiresAt slides forward while the browser is used, but never past createdAt plus
// 30 days (src/lib/auth.server.ts). lastSeenAt is written at most once an hour, so
// it is only as exact as that. deviceLabel is "Chrome on macOS", made from the
// user agent at sign-in, for the list on the Account page.
model Session {
  id          String   @id @default(uuid())
  tokenHash   String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  deviceLabel String   @default("Unknown device")

  @@index([expiresAt])
  @@index([userId])
}

// The muscle groups a movement can train. Kept in step with src/lib/muscles.ts.
enum MuscleGroup {
  chest
  shoulders
  traps
  lats
  lower_back
  biceps
  triceps
  forearms
  abs
  obliques
  glutes
  quads
  hamstrings
  calves
}

enum Equipment {
  barbell
  dumbbell
  kettlebell
  machine
  cable
  bodyweight
  other
}

// A movement is either built in (userId is null, slug is set) or a custom one a user made (userId is set).
// Sets point at this one table either way, so history, charts and PRs do not care which kind it is.
model Movement {
  id               String           @id @default(uuid())
  // Null for a built-in movement, which every user can read and nobody can change.
  userId           String?
  // Restrict, not the default SetNull of an optional relation: deleting a user must never turn their movements into built-ins.
  user             User?            @relation(fields: [userId], references: [id], onDelete: Restrict)
  // The stable key of a built-in, from src/lib/movement-catalog.ts. The seed upserts on it.
  slug             String?          @unique
  name             String
  // Pull-ups, push-ups and dips: the weight field starts at the user's body weight.
  isBodyWeight     Boolean          @default(false)
  equipment        Equipment?
  primaryMuscles   MuscleGroup[]    @default([])
  secondaryMuscles MuscleGroup[]    @default([])
  sets             Set[]
  presetExercises  PresetExercise[]
  // Set when the owner deletes a movement that is in a set or a preset. It is hidden from the library and the pickers
  // but kept, so history, charts and presets that use it stay whole. Always null for a built-in.
  archivedAt       DateTime?

  // Postgres treats nulls as different, so this stops duplicate names among a user's own movements only.
  // Built-in names are kept unique by a partial index in the movement_library migration, which Prisma cannot express.
  @@unique([userId, name])
}

model Workout {
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  id              String         @id @default(uuid())
  startedAt       DateTime       @default(now())
  completedAt     DateTime?
  sets            Set[]
  // The completed workout this one was started from ("Repeat this workout"). Its sets are the checklist of
  // planned sets, not sets of this workout. Null when it was not started from another, or once that one is deleted.
  sourceWorkoutId String?
  sourceWorkout   Workout?       @relation("RepeatedWorkout", fields: [sourceWorkoutId], references: [id], onDelete: SetNull)
  repeats         Workout[]      @relation("RepeatedWorkout")
  // The preset this workout was started from. Its series are the checklist of planned sets. Null for a workout
  // started empty or from a past workout, or once the preset is deleted.
  presetId        String?
  preset          WorkoutPreset? @relation(fields: [presetId], references: [id], onDelete: SetNull)
  // The workout's timeline: which movement was current when, and the pauses. The browser keeps it first and sends
  // it here, so the ring on the current workout page survives a reload or another device. The shape is
  // `workoutTimelineSchema` in src/lib/workout-timeline.ts. Null for a workout from before the timeline.
  timeline        Json?

  @@index([userId, completedAt])
  @@index([sourceWorkoutId])
  @@index([presetId])
}

model Set {
  id         String   @id @default(uuid())
  workoutId  String
  // A set cannot exist without its workout, so the database removes them together.
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  movementId String
  movement   Movement @relation(fields: [movementId], references: [id])
  reps       Int
  weight     Decimal  @db.Decimal(6, 2)
  createdAt  DateTime @default(now())

  @@index([workoutId])
  @@index([movementId])
}

model BodyWeight {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  weight     Decimal  @db.Decimal(6, 2)
  recordedAt DateTime @default(now())

  @@index([userId, recordedAt])
}

// A workout planned ahead and kept in the user's workout library: movements in order, each with its series and
// the rest between them. Starting one creates a Workout whose planned sets come from here.
model WorkoutPreset {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  name      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  exercises PresetExercise[]
  // The weekdays this preset is a workout of the day.
  days      PresetDay[]
  workouts  Workout[]

  @@unique([userId, name])
}

// One movement in a preset. Its series are rows below it, so a movement is added once and its series edited in place.
model PresetExercise {
  id          String        @id @default(uuid())
  presetId    String
  preset      WorkoutPreset @relation(fields: [presetId], references: [id], onDelete: Cascade)
  movementId  String
  movement    Movement      @relation(fields: [movementId], references: [id])
  position    Int
  // Seconds of rest after each series of this movement.
  restSeconds Int           @default(60)
  sets        PresetSet[]

  @@index([presetId, position])
  @@index([movementId])
}

// One series: how many reps, and optionally a weight. The weight is a value to help track progress, never required.
model PresetSet {
  id         String         @id @default(uuid())
  exerciseId String
  exercise   PresetExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  position   Int
  reps       Int
  weight     Decimal?       @db.Decimal(6, 2)

  @@index([exerciseId, position])
}

// A weekday a preset is a workout of the day. 1 is Monday and 7 is Sunday (ISO), in the user's own week.
model PresetDay {
  presetId String
  preset   WorkoutPreset @relation(fields: [presetId], references: [id], onDelete: Cascade)
  weekday  Int

  @@id([presetId, weekday])
  @@index([weekday])
}
